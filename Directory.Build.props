<Project>

  <PropertyGroup>
    <Version>1.3.0</Version>
    <Authors>Nikola Perisic</Authors>
    <Copyright>Copyright (c) 2026 Nikola Perisic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/perisicnikola37/react-dotnet-playwright-e2e-starter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://perisicnikola37.github.io/react-dotnet-playwright-e2e-starter/</PackageProjectUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
