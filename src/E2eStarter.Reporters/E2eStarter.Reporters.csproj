<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>E2eStarter.Reporters</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>e2e-report</ToolCommandName>
    <Description>dotnet tool that turns a TRX test result plus Playwright failure evidence into a data.json, a live test dashboard (index.html) and a standalone HTML report (report.html).</Description>
    <PackageTags>playwright;playwright-report;test-report;html-report;trx;xunit;e2e;test-dashboard;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="..\..\packages\dashboard\dashboard.html" LogicalName="dashboard.html" />
  </ItemGroup>

</Project>
