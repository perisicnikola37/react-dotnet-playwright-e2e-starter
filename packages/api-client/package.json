{
  "name": "@perisicnikola37/e2e-starter-client",
  "version": "1.2.0",
  "description": "Typed fetch client for the E2E starter items API. Framework-agnostic, zero dependencies.",
  "license": "MIT",
  "author": "Nikola Perisic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "keywords": ["playwright", "e2e", "react", "api-client", "typescript"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perisicnikola37/react-dotnet-playwright-e2e-starter.git",
    "directory": "packages/api-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
