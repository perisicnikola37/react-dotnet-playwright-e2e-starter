{
  "name": "@perisicnikola37/e2e-starter-dashboard",
  "version": "1.3.0",
  "description": "Single-file Playwright test dashboard and HTML report: live progress, failures with screenshots, steps, console output and traces, re-run commands.",
  "license": "MIT",
  "author": "Nikola Perisic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perisicnikola37/react-dotnet-playwright-e2e-starter.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://perisicnikola37.github.io/react-dotnet-playwright-e2e-starter/",
  "bugs": {
    "url": "https://github.com/perisicnikola37/react-dotnet-playwright-e2e-starter/issues"
  },
  "keywords": [
    "playwright",
    "playwright-report",
    "playwright-dashboard",
    "test-report",
    "html-report",
    "test-dashboard",
    "e2e",
    "ui-testing",
    "dotnet",
    "xunit"
  ],
  "files": [
    "dist",
    "demo/build.mjs",
    "README.md"
  ],
  "main": "dist/dashboard.html",
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true});require('fs').copyFileSync('dashboard.html','dist/dashboard.html')\"",
    "demo": "node demo/build.mjs --site ../../_site && npx --yes serve ../../_site"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
